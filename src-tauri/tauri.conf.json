{
  "productName": "GitHub Desktop",
  "version": "3.5.9",
  "identifier": "com.github.GitHubClient",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 660,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
